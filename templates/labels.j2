{% if ollama_container_labels_traefik_enabled %}
traefik.enable=true

{% if ollama_container_labels_traefik_docker_network %}
traefik.docker.network={{ ollama_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if ollama_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [ollama_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ ollama_identifier }}-basic-auth.basicauth.users={{ ollama_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if ollama_container_labels_traefik_compression_middleware_enabled %}
{% set middlewares = middlewares + [ollama_container_labels_traefik_compression_middleware_name] %}
{% endif %}

{#
  Intentionally not adding redirectRegex and stripPrefix middleware.
  Ollama does not support hosting under a subpath, so it is always served at `/`.
#}

{% if ollama_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in ollama_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ ollama_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [ollama_identifier + '-add-request-headers'] %}
{% endif %}

{% if ollama_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in ollama_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ ollama_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [ollama_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ ollama_identifier }}.rule={{ ollama_container_labels_traefik_rule }}
{% if ollama_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ ollama_identifier }}.priority={{ ollama_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ ollama_identifier }}.service={{ ollama_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ ollama_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ ollama_identifier }}.entrypoints={{ ollama_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ ollama_identifier }}.tls={{ ollama_container_labels_traefik_tls | to_json }}
{% if ollama_container_labels_traefik_tls %}
traefik.http.routers.{{ ollama_identifier }}.tls.certResolver={{ ollama_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ ollama_identifier }}.loadbalancer.server.port={{ ollama_container_http_port }}
{% endif %}

{% for arg in ollama_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
