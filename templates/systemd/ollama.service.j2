[Unit]
Description=Ollama ({{ ollama_identifier }})
{% for service in ollama_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in ollama_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ ollama_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ ollama_identifier }} \
      --log-driver=none \
      --user={{ ollama_uid }}:{{ ollama_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ ollama_container_network }} \
      {% if ollama_container_http_host_bind_port %}
      -p {{ ollama_container_http_host_bind_port }}:{{ ollama_container_http_port }} \
      {% endif %}
      --env-file={{ ollama_base_path }}/env \
      --label-file={{ ollama_base_path }}/labels \
      --mount type=bind,src={{ ollama_data_path }},dst={{ ollama_environment_variables_home }}/.ollama \
      {% for volume in ollama_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for device in ollama_container_devices %}
      --device={{ device.src }}:{{ device.dst }}{{ (':' + device.options) if device.options | default('') else '' }} \
      {% endfor %}
      {% for gpu in ollama_container_gpus %}
      --gpus={{ gpu }} \
      {% endfor %}
      {% for group in ollama_container_group_add %}
      --group-add={{ group }} \
      {% endfor %}
      {% for arg in ollama_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ ollama_container_image }} \
      {% if ollama_process_extra_arguments %}
      {# Arguments replace the image's own command instead of extending it, so it is repeated here. #}
      serve \
      {% for arg in ollama_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {% endif %}

{% for network in ollama_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ ollama_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ ollama_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ ollama_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ ollama_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ ollama_identifier }}

[Install]
WantedBy=multi-user.target
